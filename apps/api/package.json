{
  "name": "@kyzn/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests drizzle.config.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@kyzn/shared": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "supertest": "^7.1.4"
  }
}
